{
  "name": "veracode-user-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "dashboard",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,dashboard -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w dashboard\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w e2e",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run e2e",
    "prepare": "simple-git-hooks",
    "precommit": "node scripts/check-no-vault.mjs && npm run format && npm run lint && npm run typecheck && npm run test && npm run e2e && npm run scan",
    "connect": "tsx backend/src/connect/main.ts",
    "scan": "node scripts/veracode-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run precommit"
  }
}
