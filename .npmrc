# Every install goes through the Veracode package firewall. Its access key is committed on purpose:
# it isn't a secret (docs/PROCESS.md, "Packages").
registry=https://npm.firewall.veracode.com/
# The access key, as base64 of "-:KEY". npm sends it with every request to the firewall, package
# downloads included. A key in the registry URL is used for lookups only (docs/REALITY.md, entry 19).
//npm.firewall.veracode.com/:_auth=LTphdjBfZ1ZSemo3N1ZoeHUyajFzQ2VNNXZhTzVzQmRSNGVDek9reVdOelZkWk5oRw==
# The firewall's other credential keys, set empty so that no user or global npmrc can supply its own.
//npm.firewall.veracode.com/:_authToken=
//npm.firewall.veracode.com/:username=
//npm.firewall.veracode.com/:_password=
replace-registry-host=never
